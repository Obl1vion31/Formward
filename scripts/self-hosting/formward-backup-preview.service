# formward-self-hosting-managed-v1
[Unit]
Description=Back up Formward preview PostgreSQL
After=postgresql@18-main.service
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/lib/postgresql
ExecStart=/usr/local/libexec/formward-backup-preview
TimeoutStartSec=20min
UMask=0077
# root 维护任务须能切换到 postgres 进行本机 peer 认证；应用服务仍启用 NoNewPrivileges。
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/formward
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
SyslogIdentifier=formward-backup-preview
LogRateLimitIntervalSec=30s
LogRateLimitBurst=30
