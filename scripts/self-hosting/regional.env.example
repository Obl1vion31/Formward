# 上海区域业务实例；本文件只有示例，不包含真实凭据。
FORMWARD_ENVIRONMENT=preview
FORMWARD_EXPECTED_DATABASE=formward_preview
FORMWARD_REGIONAL=1
BETTER_AUTH_URL=https://formward-ten.vercel.app
FORMWARD_SELECTOR_ORIGIN=https://formward.top
FORMWARD_CN_ORIGIN=https://cn.formward.top
FORMWARD_GLOBAL_ORIGIN=https://global.formward.top
FORMWARD_ORIGIN_URL=https://origin.formward.top
FORMWARD_IMAGE_WORKER_URL=https://global.formward.top
FORMWARD_IMAGE_REGION=cn
FORMWARD_INTERNAL_JWKS_URL=http://127.0.0.1:3000/api/auth/jwks
# 三个独立随机值分别用于业务网关、图片能力和本机readiness。
FORMWARD_GATEWAY_SECRET=
FORMWARD_IMAGE_SECRET=
FORMWARD_READINESS_SECRET=
FORMWARD_COS_BUCKET=
FORMWARD_COS_REGION=ap-shanghai
FORMWARD_COS_SECRET_ID=
FORMWARD_COS_SECRET_KEY=
FORMWARD_BLOB_LOCATION=legacy
# 国际节点只需入口配置、FORMWARD_GATEWAY_SECRET、FORMWARD_IMAGE_SECRET、
# FORMWARD_BLOB_LOCATION及BLOB_READ_WRITE_TOKEN；不配置DATABASE_URL或BETTER_AUTH_SECRET。
