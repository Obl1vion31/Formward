{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitThis": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@doubao-dev/framework",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["@doubao-dev/framework/types"]
  },
  "include": ["src", "tests"]
}
