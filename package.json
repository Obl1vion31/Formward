{
  "name": "formward",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none src/app/*.test.mjs src/features/auth/*.test.ts src/features/measurements/*.test.ts",
    "db:local": "pglite-server --db=./data/postgres/storage --host=127.0.0.1 --port=5432 --max-connections=10",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mts",
    "account:create": "node --env-file=.env.local --import tsx scripts/create-account.mts",
    "test:browser": "node --import tsx tests/auth.browser.mts",
    "test:measurements-http": "node --import tsx tests/measurements.http.mts",
    "test:measurements-browser": "FORMWARD_MEASUREMENTS_BROWSER=1 node --import tsx tests/measurements.http.mts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
