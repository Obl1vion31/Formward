{
  "name": "formward",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none src/app/*.test.mjs src/features/auth/*.test.ts src/features/measurements/*.test.ts src/features/meals/*.test.ts src/features/dashboard/*.test.ts src/features/records/*.test.ts src/features/activities/*.test.ts src/features/exports/*.test.ts src/features/onboarding/*.test.ts src/features/assistant/*.test.ts src/features/garmin/*.test.ts src/features/data-sources/*.test.ts src/features/training/*.test.ts src/features/doubao/*.test.ts",
    "garmin:preview": "node --import tsx scripts/preview-garmin.mts",
    "db:local": "pglite-server --db=./data/postgres/storage --host=127.0.0.1 --port=5432 --max-connections=10",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mts",
    "account:create": "node --env-file=.env.local --import tsx scripts/create-account.mts",
    "account:owner": "node --env-file=.env.local --import tsx scripts/manage-account.mts",
    "test:account-browser": "node --import tsx tests/accounts.browser.mts",
    "test:account-concurrency": "node --import tsx tests/accounts.concurrent.mts",
    "test:browser": "node --import tsx tests/auth.browser.mts",
    "test:measurements-http": "node --import tsx tests/measurements.http.mts",
    "test:measurements-browser": "FORMWARD_MEASUREMENTS_BROWSER=1 node --import tsx tests/measurements.http.mts",
    "ai:setup": "node --import tsx scripts/ai-setup.mts",
    "ai:request": "node --import tsx scripts/ai-request.mts",
    "test:records-browser": "node --import tsx tests/records.browser.mts",
    "test:meals-browser": "node --import tsx tests/meals.browser.mts",
    "meals:preview": "node --env-file=.env.local --import tsx scripts/preview-meals.mts",
    "test:energy-browser": "node --import tsx tests/energy.browser.mts",
    "test:onboarding-browser": "node --import tsx tests/onboarding.browser.mjs",
    "test:visual": "node --import tsx tests/overview-theme.browser.mjs",
    "test:app-version": "node --import tsx tests/app-version.browser.mjs",
    "test:detail-browser": "node --import tsx tests/detail-hierarchy.browser.mjs",
    "test:chat-browser": "node --import tsx tests/chat-pilot.browser.mts",
    "test:assistant-browser": "node --import tsx tests/assistant-suite.browser.mts",
    "test:desktop-linked-browser": "node --import tsx tests/desktop-linked.browser.mts",
    "test:loading-browser": "node --import tsx tests/workspace-loading.browser.mts",
    "test:training-browser": "node --import tsx tests/training.browser.mts",
    "test:regional-concurrency": "node --import tsx tests/regional.concurrent.mts",
    "test:regional-browser": "node --import tsx tests/regional.browser.mts",
    "release:regional": "node --import tsx scripts/self-hosting/build-regional-release.mts",
    "test:mobile-interface-browser": "FORMWARD_MOBILE_INTERFACE=1 node --import tsx tests/chat-pilot.browser.mts"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/core": "1.7.7",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/server": "^2",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "cos-nodejs-sdk-v5": "2.15.4",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@modelcontextprotocol/client": "2.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
