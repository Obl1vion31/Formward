# 在 Neon 控制台点击 Connect，复制完整的 PostgreSQL 连接串并保留 TLS 参数。
DATABASE_URL=""
# 本机离线开发可运行 pnpm db:local，并使用 postgresql://postgres:postgres@127.0.0.1:5432/postgres。
# 可选：Neon 的直接连接，用于 migration；留空时使用 DATABASE_URL。
DATABASE_MIGRATION_URL=""
# 使用随机的至少 32 字符 secret；不要使用网页登录密码。
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
