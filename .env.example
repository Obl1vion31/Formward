# 在 Neon 控制台点击 Connect，复制完整的 PostgreSQL 连接串并保留 TLS 参数。
DATABASE_URL=""
# 本机离线开发可运行 pnpm db:local，并使用 postgresql://postgres:postgres@127.0.0.1:5432/postgres。
# 可选：Neon 的直接连接，用于 migration；留空时使用 DATABASE_URL。
DATABASE_MIGRATION_URL=""
# 使用随机的至少 32 字符 secret；不要使用网页登录密码。
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# 可选：Vercel 关联 Private Blob 后自动配置 BLOB_STORE_ID，SDK 使用平台 OIDC。
BLOB_STORE_ID=""
# 本地使用私有 Blob 时可配置静态凭据；生产 OIDC 不需要此变量。仅服务端读取。
BLOB_READ_WRITE_TOKEN=""

# personal：已登录账号可填写本人的 Garmin Personal 密钥；pilot：仅指定账号；disabled：关闭。
# 未配置时保留原 pilot 行为，不会在升级后自动扩大范围。
FORMWARD_DATA_SOURCE_ACCESS="pilot"
# pilot 模式的固定 user_id；留空不开放。
FORMWARD_DATA_SOURCE_USER_ID=""
# 独立随机 32 字节密钥的 64 位十六进制文本，仅服务端使用。
FORMWARD_DATA_SOURCE_ENCRYPTION_KEY=""
# 后台每日同步的独立随机密钥，仅服务端使用。
CRON_SECRET=""

# 独立豆包接入；默认关闭，缺少配置只影响豆包入口，不改变既有 GPT 连接。
FORMWARD_DOUBAO_ENABLED="0"
FORMWARD_DOUBAO_APP_ID=""
# 仅上海业务服务读取，不进入 Vercel 网关或前端。
FORMWARD_DOUBAO_APP_SECRET=""
FORMWARD_DOUBAO_ORIGIN="https://global.formward.top"
DOUBAO_OPENAPI_BASE_DOMAIN="https://api.doubao-dev.com"
